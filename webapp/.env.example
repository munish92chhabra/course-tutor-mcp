# Copy to .env and fill in. Never commit the real file.

# Required: your key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required in practice: the password you give the class.
# Leave it empty and anyone with the URL can spend your credits.
CLASS_PASSWORD=change-me

# Optional: your own password. Signing in with this one unlocks marking
# schemes from course/assessments_private/ and difficulty ratings.
# Leave it empty and nobody can reach marking schemes through the web app.
TEACHER_PASSWORD=

# Required in production: keeps students logged in across restarts.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Where your course material lives
COURSE_DIR=./course
COURSE_NAME=Introductory Microbiology

# Model and cost controls
MODEL=claude-haiku-5-5
MAX_TOKENS=2000
NOTE_HITS=4
EXAM_HITS=2
SCHEME_HITS=2

# Where student questions are logged. Set to "" to turn logging off.
QUESTION_LOG=

# Per-student limits
RATE_LIMIT=20
RATE_WINDOW=3600
